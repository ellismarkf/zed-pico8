{
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i}=${2:1},${3:10} do",
      "\t$0",
      "end"
    ],
    "description": "for loop"
  },
  "fors": {
    "prefix": "fors",
    "body": [
      "for ${1:i}=${2:1},${3:10},${4:2} do",
